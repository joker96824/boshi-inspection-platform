# 博实智能巡检平台 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ============================================
# 数据库配置（必须配置）
# ============================================

# MySQL 数据库连接（示例）
# DATABASE_URL=mysql+aiomysql://用户名:密码@数据库主机:3306/数据库名
DATABASE_URL=mysql+aiomysql://boshi:Xx147258.@192.168.8.126/boshirobot

# PostgreSQL 数据库连接（示例，如需使用PostgreSQL，取消注释并修改）
# DATABASE_URL=postgresql+asyncpg://用户名:密码@数据库主机:5432/数据库名
# DATABASE_URL=postgresql+asyncpg://boshi:password123@192.168.1.100:5432/boshirobot

# ============================================
# Redis 配置（可选，默认禁用）
# ============================================

# 是否启用 Redis（默认 false，不启用）
REDIS_ENABLED=false

# Redis 连接配置（仅在 REDIS_ENABLED=true 时生效）
# REDIS_URL=redis://:密码@Redis主机:6379/数据库编号
# 示例（无密码）：redis://192.168.1.100:6379/0
# 示例（有密码）：redis://:mypassword@192.168.1.100:6379/0
REDIS_URL=redis://192.168.1.100:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 应用配置
# ============================================

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=production

# ============================================
# Docker 网络模式（可选）
# ============================================

# 如果数据库在宿主机上，使用 host 模式
# 如果数据库在远程服务器，使用 bridge 模式（默认）
# NETWORK_MODE=host
NETWORK_MODE=bridge


# JWT配置 - 生产环境强密钥
SECRET_KEY=boshi-inspection-platform-super-secret-key-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS配置 - 允许所有来源（测试用）
CORS_ORIGINS=["*"]
CORS_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_HEADERS=["*"]

# ROS2配置
ROS_DOMAIN_ID=0
ROS_BRIDGE_PORT=9090
ROS_BRIDGE_HOST=localhost
